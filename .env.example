# Environment template for local development.
# Copy to .env.local and fill in what you need:
#
#   cp .env.example .env.local
#
# All env access goes through src/lib/env.ts — never read process.env elsewhere.

# Required for the AskFernando AI chat (/api/chat).
# Without it the route returns 503 by design; the rest of the site works fine.
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Full URL of the deployed site, used to restrict CORS on /api/chat.
# Defaults to http://localhost:3000 in development when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — raises GitHub API rate limits for the GitHub Activity section.
# Unauthenticated access (60 req/h) is enough with hourly ISR.
GITHUB_TOKEN=

# Optional — used by `npm run psi` to query the PageSpeed Insights API.
# Unauthenticated requests work but 429 within a handful of calls/day.
# Get a free key at https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# Note: VERCEL_URL is injected automatically by Vercel on deployed environments.
# It is used as the CORS-origin fallback when NEXT_PUBLIC_SITE_URL is unset —
# never set it manually.
